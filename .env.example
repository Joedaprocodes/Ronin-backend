# Copy to .env and fill in what you need. .env is gitignored.

# --- WhatsApp / API ---
# TEST_NUMBER=2348012345678
# Bind port. Precedence: PORT (injected by hosts like Render/Railway) ->
# API_PORT -> 3001. Local dev only needs API_PORT.
# API_PORT=3001
# API_TOKEN=change-me

# --- Database (optional) ---
# Set DATABASE_URL to store the WhatsApp session + messages in Postgres (e.g.
# Supabase). Leave it unset for local development: the session goes to ./auth
# and messages to a local SQLite file.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
# LOCAL_DB=./data/messages.db

# --- Media storage ---
# Development (default): media bytes live on disk under MEDIA_DIR.
# Production: set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to keep media in a
# Supabase Storage bucket instead. The bucket is created on first use and is
# public-read, so message views return the Supabase public URL and the browser
# loads it straight from Supabase (no proxying through this server).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...   # server-only secret; never the anon key
# SUPABASE_MEDIA_BUCKET=media     # optional, defaults to "media"
# MEDIA_DIR=./data/media          # the local disk store (development)
# MEDIA_DRIVER=supabase           # optional: force "supabase" or "disk"
